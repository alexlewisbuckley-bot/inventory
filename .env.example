# PostgreSQL connection string.
# Use a POOLED endpoint in production — each serverless instance opens its own
# pool, and a direct connection will exhaust the limit under light concurrency.
#   Neon:     postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
#   Local:    postgresql://postgres@localhost:5432/bluecroft
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# 48+ random characters used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Session lifetime in seconds (default 7 days).
SESSION_MAX_AGE=604800

# GBP -> USD rate used for new purchases until one is set in Settings.
DEFAULT_FX_GBP_USD=1.33

# Connections per instance. Keep small on serverless.
DATABASE_POOL_MAX=5
