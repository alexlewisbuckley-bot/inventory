# PostgreSQL connection string.
# Use a POOLED endpoint in production — each serverless instance opens its own
# pool, and a direct connection will exhaust the limit under light concurrency.
#   Neon:     postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
#   Local:    postgresql://postgres@localhost:5432/bluecroft
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# 48+ random characters used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Session lifetime in seconds (default 7 days).
SESSION_MAX_AGE=604800

# GBP -> USD rate used for new purchases until one is set in Settings.
DEFAULT_FX_GBP_USD=1.33

# Lets Claude read supplier invoices dropped on Inventory → Book in from an
# invoice. Optional: without it the invoice reader falls back to pattern
# matching, which handles tidy table layouts but not scans or unusual
# templates. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Only needed if the key above is identity-linked — issued against a person
# rather than a workspace. Those keys must name the workspace on every request
# and the API refuses them otherwise. Find it in the Anthropic console URL when
# the workspace is open; it looks like wrkspc_01ABC... A workspace-scoped key
# needs no value here.
ANTHROPIC_WORKSPACE_ID=""

# Checking a supplier's VAT number against HMRC. Optional: without these the
# number is still checked against its own check digits, which catches a
# misread, but not against the register.
#
# Create an application on the HMRC Developer Hub for the "Check a UK VAT
# Number" API. Sandbox credentials are issued immediately and return test data
# only; production credentials are requested separately once you have tested.
#   sandbox     https://test-api.service.hmrc.gov.uk   (the default)
#   production  https://api.service.hmrc.gov.uk
HMRC_CLIENT_ID=""
HMRC_CLIENT_SECRET=""
HMRC_VAT_API_BASE=""
# Only if the scope the Hub shows for your application differs from the default.
HMRC_VAT_API_SCOPE=""

# Connections per instance. Keep small on serverless.
DATABASE_POOL_MAX=5

# --- WhatsApp relay (optional) ---------------------------------------------
# Trade enquiries are always written to the application and shown in the bell.
# With these set they are also relayed to the owner's phone, using Meta's
# Cloud API. Unset is a supported state: nothing is lost, it simply stays
# in-app.
#
# WHATSAPP_TOKEN            permanent access token for the system user
# WHATSAPP_PHONE_NUMBER_ID  the sending number's id, not the number itself
# WHATSAPP_TEMPLATE         an approved template name. Meta forbids free text
#                           outside a 24-hour window the recipient opens, so
#                           without a template an owner who has never messaged
#                           the business number receives nothing.
# WHATSAPP_TEMPLATE_LANG    defaults to en_GB
# WHATSAPP_DEFAULT_COUNTRY  dialling code for numbers stored with a leading
#                           zero. Defaults to 44.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE=""
