# Database — SQLite for local dev; swap to postgresql:// for production
DATABASE_URL="file:./data/app.db"

# 32+ character secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Session lifetime in seconds (default 7 days)
SESSION_MAX_AGE=604800

# Base currency FX fallback used when no live rate is configured (GBP -> USD)
DEFAULT_FX_GBP_USD=1.33
